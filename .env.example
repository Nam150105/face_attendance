POSTGRES_DB=face_attendance
POSTGRES_USER=face_attendance
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://face_attendance:change-me-local-only@postgres:5432/face_attendance
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=face-attendance-local
S3_SECRET_KEY=change-me-local-only
S3_BUCKET=face-attendance-private
S3_SERVER_SIDE_ENCRYPTION=false
JWT_SECRET=change-me-local-only
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=90
# Trần số phiên đang mở của một tài khoản khi vai trò được dùng nhiều thiết bị
MAX_DEVICES_PER_USER=10
CORS_ALLOW_ORIGINS=http://localhost:3000,https://localhost
AUTH_DEBUG_RETURN_RESET_TOKEN=false
FACE_MODEL_NAME=not-configured
FACE_MODEL_VERSION=not-configured
FACE_MATCH_THRESHOLD=0.35
FACE_AI_ENABLE_EMBEDDINGS=false
FACE_DETECTOR_MODEL_PATH=/models/detector/face_detector.onnx
FACE_EMBEDDING_MODEL_PATH=/models/embedding/arcface.onnx
FACE_EMBEDDING_DIMENSION=512
GPS_MIN_ACCURACY_METERS=100
DEFAULT_ALLOW_RADIUS_METERS=100
DEFAULT_WARNING_RADIUS_METERS=200
MINIO_ROOT_USER=face-attendance-local
MINIO_ROOT_PASSWORD=change-me-local-only
HTTPS_HOSTS=localhost
PUBLIC_APP_ORIGIN=https://localhost
CLOUDFLARED_CREDENTIALS_FILE=./proxy/cloudflared-credentials.json
